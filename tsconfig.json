{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",

    "src/components/layout/AppShell.tsx",
    "src/components/layout/AppShell.css",

    "src/features/authentication/AuthProvider.tsx",
    "src/features/authentication/ProtectedRoute.tsx",
    "src/features/authentication/LoginPage.tsx",
    "src/features/authentication/auth.css",

    "src/features/dashboard/HomePage.tsx",
    "src/features/dashboard/HomePage.css",

    "src/features/transactions/ActivityPage.tsx",
    "src/features/transactions/ActivityPage.css",
    "src/features/transactions/TransactionForm.tsx",
    "src/features/transactions/TransactionForm.css",

    "src/features/receipts/ReceiptsPage.tsx",
    "src/features/receipts/ReceiptsPage.css",

    "src/features/goals/GoalsSection.tsx",
    "src/features/goals/GoalsSection.css",

    "src/features/wishlist/WishlistSection.tsx",
    "src/features/wishlist/WishlistSection.css",

    "src/features/plus/PlusPage.tsx",
    "src/features/plus/PlusPage.css",

    "src/features/settings/MorePage.tsx",
    "src/features/settings/MorePage.css",

    "src/hooks/useTransactions.ts",
    "src/hooks/useSavingsGoals.ts",
    "src/hooks/useReceipts.ts",
    "src/hooks/useWishlist.ts",
    "src/hooks/useDisplayCurrency.ts",

    "src/lib/supabase.ts",
    "src/lib/utils.ts",
    "src/lib/currency.ts",
    "src/lib/insights.ts",
    "src/lib/stripe.ts",
    "src/lib/i18n.ts",
    "src/lib/localOcr.ts",

    "src/services/transactions.ts",
    "src/services/receipts.ts",
    "src/services/wishlist.ts",

    "src/types/transaction.ts",
    "src/types/savingsGoal.ts",
    "src/types/wishlist.ts",
    "src/types/receipt.ts",
    "src/types/recurringPayment.ts",

    "src/styles/global.css"
  ],
  "exclude": ["node_modules", "dist"]
}
